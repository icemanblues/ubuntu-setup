# Window/session indexing starts at 1
set -g base-index 1
setw -g pane-base-index 1

# Update every second
set -g status-interval 1

# Mouse support
set -g mouse on

# --- Status bar configuration ---
set -g status on
set -g status-position bottom
set -g status-style "bg=#1c1c1c,fg=#cccccc"

# Left side: session name and window list
set -g status-left "[#[fg=green,bold]#S#[default]] "
set -g status-left-length 100

# Right side: session count, hostname, day, date, time
set -g status-right " #[fg=yellow](#(tmux list-sessions 2>/dev/null | wc -l) sessions)#[default] #[fg=white]#h#[default] #[fg=blue]%A#[default] #[fg=blue]%d %b %Y#[default] #[fg=cyan]%H:%M:%S#[default] "
set -g status-right-length 120
